# Copy this file to .env.local for local development
# Add all of these as Environment Variables in Vercel dashboard

# ── Supabase ──────────────────────────────────────────────────────────────────
# From: Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # NOT the anon key — keep this server-side only

# ── Resend ────────────────────────────────────────────────────────────────────
# From: resend.com → API Keys
RESEND_API_KEY=re_your_api_key

# The "from" address — must be a domain you've verified in Resend.
# During testing you can use: onboarding@resend.dev  (Resend's sandbox address)
EMAIL_FROM=oe@obiemeka.com

# Where booking notifications go (defaults to oe@obiemeka.com if not set)
NOTIFY_EMAIL=oe@obiemeka.com

# ── Flutterwave ───────────────────────────────────────────────────────────────
# From: Flutterwave dashboard → Settings → API Keys
# Use the TEST keys until you've confirmed the full flow end-to-end, then swap to LIVE.
# Both keys must be from the SAME mode (test or live) — a live secret key with a
# test public key (or vice versa) will fail at checkout.
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X
# Public key — safe to expose client-side; sent to the browser so it can open
# Flutterwave's inline checkout modal directly (api/submit-booking.js returns it).
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxxxxx-X

# From: Flutterwave dashboard → Settings → Webhooks → set a "Secret Hash" there,
# then copy the same value here. Used to verify webhook calls are really from Flutterwave.
FLUTTERWAVE_WEBHOOK_SECRET_HASH=choose-a-long-random-string-and-set-it-in-both-places

# Also set your webhook URL in the Flutterwave dashboard to:
#   https://obiemeka.com/api/flutterwave-webhook

# ── Site ──────────────────────────────────────────────────────────────────────
# Used to build the Flutterwave redirect/logo URLs. Defaults to https://obiemeka.com if not set.
SITE_URL=https://obiemeka.com
